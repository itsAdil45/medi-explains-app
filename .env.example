# Copy to .env.local and fill in your backend's address.
# The website's client.js could use a relative "/api" because the browser
# fills in the origin automatically; a native app has no origin to inherit,
# so this needs to be the full URL (e.g. https://api.aihealthcareplus.com,
# or your machine's LAN IP + port for local dev, since "localhost" on a
# phone/emulator points at the phone itself, not your dev machine).
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
